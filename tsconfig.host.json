{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/contracts.ts",
    "src/index.ts",
    "src/host/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
